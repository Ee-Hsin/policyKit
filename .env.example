OPENAI_API_KEY=
OPENAI_AGENT_MODEL=gpt-5.4-mini
OPENAI_CHECKER_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_STORE_RESPONSES=false
OPENAI_TIMEOUT_SECONDS=60
OPENAI_AGENT_MAX_OUTPUT_TOKENS=1200
OPENAI_CHECKER_MAX_OUTPUT_TOKENS=6000

DATABASE_URL=postgresql+asyncpg:///policykit

CHROMA_MODE=persistent
CHROMA_PERSIST_DIRECTORY=.data/chroma
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_SSL=false

APP_ENV=development
APP_SECRET_KEY=change-me-in-production
CORS_ORIGINS=["http://localhost:3000"]
RUN_AGENT_WORKER=true
AGENT_POLL_INTERVAL_SECONDS=1
AGENT_MAX_STEPS=12
